<%- include('partials/header', { title }) %><main class="bb-container"><div class="bb-form-card"><span class="bb-eyebrow">Grow the bookshelf</span><h1>Add a book</h1><p class="bb-muted">Share a book with the BookBuddy community. The server checks every field before saving it.</p>
<% if (success) { %><div class="bb-alert success" role="status">✓ <%= success %></div><% } %><% if (errors.length) { %><div class="bb-alert error" role="alert"><strong>Please correct the following:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
<form method="POST" action="/books" novalidate><div class="bb-form-grid"><div class="bb-field"><label for="title">Book title *</label><input id="title" name="title" value="<%= values.title || '' %>" required minlength="2" maxlength="100"><span class="bb-help">2–100 characters</span></div><div class="bb-field"><label for="author">Author *</label><input id="author" name="author" value="<%= values.author || '' %>" required minlength="2" maxlength="80"><span class="bb-help">2–80 characters</span></div><div class="bb-field"><label for="genre">Genre *</label><select id="genre" name="genre" required><option value="">Choose genre</option><% ['Fiction','Mystery','Fantasy','Romance','Biography','Non-fiction','Drama'].forEach(g => { %><option <%= values.genre === g ? 'selected' : '' %>><%= g %></option><% }) %></select></div><div class="bb-field"><label for="language">Language *</label><select id="language" name="language" required><option value="">Choose language</option><% ['English','Hindi','Marathi'].forEach(l => { %><option <%= values.language === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div><div class="bb-field full"><label for="image">Cover image URL (optional)</label><input id="image" name="image" type="url" value="<%= values.image || '' %>" placeholder="https://example.com/book-cover.jpg"><span class="bb-help">Must be a valid HTTP/HTTPS URL if supplied.</span></div><div class="bb-field full"><label for="description">Description *</label><textarea id="description" name="description" required minlength="20" maxlength="800"><%= values.description || '' %></textarea><span class="bb-help">20–800 characters</span></div><div class="bb-field full"><button class="bb-btn" type="submit">Validate and add book</button></div></div></form></div></main><%- include('partials/footer') %>
