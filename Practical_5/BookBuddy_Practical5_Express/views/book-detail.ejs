<%- include('partials/header', { title }) %><main class="bb-container"><a href="/books">← Back to all books</a><div class="bb-grid" style="grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);margin-top:20px"><div class="bb-card" style="padding:0;overflow:hidden"><div class="bb-cover" style="height:360px"><img src="<%= book.image %>" alt="Cover for <%= book.title %>" onerror="this.style.display='none'"></div></div><section class="bb-panel"><span class="bb-tag"><%= book.genre %></span><h1><%= book.title %></h1><p class="bb-muted">by <%= book.author %> · <%= book.language %></p><p><%= book.description %></p><a class="bb-btn" href="/reviews/new">Write a review</a><h2 style="margin-top:28px">Reader reviews (<%= (book.reviews || []).length %>)</h2><% if (book.reviews && book.reviews.length) { book.reviews.forEach(review => { %><div class="bb-review"><strong><%= review.name %></strong> <span class="bb-stars"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></span><p><%= review.text %></p></div><% }) } else { %><p class="bb-muted">No reviews yet. Be the first to share your thoughts.</p><% } %></section></div></main><%- include('partials/footer') %>
