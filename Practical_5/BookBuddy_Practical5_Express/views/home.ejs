<%- include('partials/header', { title }) %><main class="bb-container">
<section class="bb-hero"><div><span class="bb-eyebrow">Your next chapter starts here</span><h1>Find stories.<br>Share your world.</h1><p>Discover your next favourite book, explore honest reader reviews, and add your own recommendations to the community.</p><div class="bb-actions"><a class="bb-btn" href="/books">Explore books →</a><a class="bb-btn secondary" href="/books/new">＋ Add a book</a></div></div><div class="bb-hero-art">📚</div></section>
<section class="bb-stats"><div class="bb-stat"><span class="bb-muted">Books in the library</span><strong><%= totalBooks %></strong></div><div class="bb-stat"><span class="bb-muted">Reader reviews</span><strong><%= totalReviews %></strong></div><div class="bb-stat"><span class="bb-muted">Ways to participate</span><strong>2</strong><span class="bb-muted">Add a book or write a review</span></div></section>
<div class="bb-section-head"><div><span class="bb-eyebrow">Reader favourites</span><h2>Featured books</h2></div><a href="/books">View all books →</a></div>
<div class="bb-grid"><% books.forEach(book => { %><article class="bb-card bb-book"><div class="bb-cover"><img src="<%= book.image %>" alt="Cover for <%= book.title %>" onerror="this.style.display='none'"></div><div class="bb-book-body"><span class="bb-tag"><%= book.genre %></span><h3><a href="/books/<%= book.id %>"><%= book.title %></a></h3><p>by <%= book.author %></p><a href="/books/<%= book.id %>">View details →</a></div></article><% }) %></div>
</main><%- include('partials/footer') %>
