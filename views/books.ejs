<%- include('partials/header', { title }) %><main class="bb-container"><span class="bb-eyebrow">The community bookshelf</span><h1>Explore books</h1><p class="bb-muted">Search the collection by title or author, or narrow it down by genre.</p>
<form class="bb-search" method="GET" action="/books"><input name="q" value="<%= q %>" placeholder="Search title or author..."><select name="genre"><option value="">All genres</option><% genres.forEach(g => { %><option value="<%= g %>" <%= genre === g ? 'selected' : '' %>><%= g %></option><% }) %></select><button class="bb-btn" type="submit">Search</button></form>
<p class="bb-muted"><%= books.length %> book(s) found.</p><% if (books.length) { %><div class="bb-grid"><% books.forEach(book => { %><article class="bb-card bb-book"><div class="bb-cover"><img src="<%= book.image %>" alt="Cover for <%= book.title %>" onerror="this.style.display='none'"></div><div class="bb-book-body"><span class="bb-tag"><%= book.genre %></span><h3><a href="/books/<%= book.id %>"><%= book.title %></a></h3><p>by <%= book.author %></p><p><%= book.description.length > 105 ? book.description.slice(0,105) + '…' : book.description %></p><a href="/books/<%= book.id %>">Read more →</a></div></article><% }) %></div><% } else { %><div class="bb-panel"><h3>No books found</h3><p>Try another search or add a new book to the collection.</p><a class="bb-btn" href="/books/new">Add a book</a></div><% } %>
</main><%- include('partials/footer') %>
