<%- include('partials/header', { title }) %><main class="bb-container"><div class="bb-form-card"><span class="bb-eyebrow">Help another reader</span><h1>Write a review</h1><p class="bb-muted">Your review is checked by Express.js before it is saved.</p>
<% if (success) { %><div class="bb-alert success" role="status">✓ <%= success %></div><% } %><% if (errors.length) { %><div class="bb-alert error" role="alert"><strong>Please correct the following:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
<% if (!books.length) { %><div class="bb-alert error">There are no books to review yet. <a href="/books/new">Add a book first.</a></div><% } %><form method="POST" action="/reviews" novalidate><div class="bb-form-grid"><div class="bb-field full"><label for="bookId">Choose a book *</label><select id="bookId" name="bookId" required><option value="">Select a book</option><% books.forEach(book => { %><option value="<%= book.id %>" <%= String(values.bookId || '') === String(book.id) ? 'selected' : '' %>><%= book.title %> — <%= book.author %></option><% }) %></select></div><div class="bb-field"><label for="name">Your name *</label><input id="name" name="name" value="<%= values.name || '' %>" required minlength="2" maxlength="50"></div><div class="bb-field"><label for="rating">Rating *</label><select id="rating" name="rating" required><option value="">Choose rating</option><% [5,4,3,2,1].forEach(n => { %><option value="<%= n %>" <%= String(values.rating || '') === String(n) ? 'selected' : '' %>><%= n %> / 5 stars</option><% }) %></select></div><div class="bb-field full"><label for="text">Your review *</label><textarea id="text" name="text" required minlength="5" maxlength="500"><%= values.text || '' %></textarea><span class="bb-help">5–500 characters</span></div><div class="bb-field full"><button class="bb-btn" type="submit">Submit review</button></div></div></form></div></main><%- include('partials/footer') %>
