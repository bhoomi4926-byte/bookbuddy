<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BookBuddy</title><link rel="stylesheet" href="/style.css">
  <style>
    :root{--bb-ink:#25233a;--bb-muted:#6d6b7b;--bb-primary:#6654d9;--bb-bg:#f7f6fc;--bb-card:#fff;--bb-border:#e9e6f2;--bb-accent:#f0edff}
    *{box-sizing:border-box}body{margin:0;background:var(--bb-bg);color:var(--bb-ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.55}
    .bb-nav{background:#fff;border-bottom:1px solid var(--bb-border);position:sticky;top:0;z-index:10}.bb-nav-inner{max-width:1120px;margin:auto;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.bb-brand{font-weight:850;font-size:1.35rem;color:var(--bb-primary);text-decoration:none;letter-spacing:-.5px}.bb-links{display:flex;gap:18px;flex-wrap:wrap;align-items:center}.bb-links a{color:var(--bb-muted);text-decoration:none;font-weight:650;font-size:.94rem}.bb-links a:hover,.bb-links a.active{color:var(--bb-primary)}.bb-links .bb-cta,.bb-btn{background:var(--bb-primary);color:white!important;padding:10px 15px;border-radius:10px;text-decoration:none;border:0;font:inherit;font-weight:700;cursor:pointer;display:inline-block}.bb-container{max-width:1120px;margin:0 auto;padding:34px 22px 58px}.bb-muted{color:var(--bb-muted)}.bb-eyebrow{color:var(--bb-primary);font-weight:800;text-transform:uppercase;letter-spacing:1.5px;font-size:.76rem}.bb-hero{background:linear-gradient(125deg,#ede9ff,#fff 60%,#fceefa);padding:46px;border:1px solid var(--bb-border);border-radius:24px;display:grid;grid-template-columns:1.35fr .65fr;gap:22px;align-items:center}.bb-hero h1{font-size:clamp(2.1rem,5vw,3.6rem);line-height:1.08;letter-spacing:-1.5px;margin:10px 0 16px}.bb-hero p{max-width:570px;color:var(--bb-muted);font-size:1.06rem}.bb-hero-art{font-size:7rem;text-align:center;filter:drop-shadow(0 12px 12px #6654d933)}.bb-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.bb-btn.secondary{background:#fff;color:var(--bb-primary)!important;border:1px solid var(--bb-border)}.bb-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin:22px 0 34px}.bb-stat,.bb-card,.bb-form-card,.bb-panel{background:#fff;border:1px solid var(--bb-border);border-radius:17px;padding:20px}.bb-stat strong{font-size:1.8rem;display:block}.bb-section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:34px 0 16px}.bb-section-head h2{margin:0}.bb-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.bb-book{overflow:hidden;padding:0}.bb-cover{height:185px;background:#eeebfa;display:flex;align-items:center;justify-content:center;overflow:hidden}.bb-cover img{width:100%;height:100%;object-fit:cover}.bb-book-body{padding:18px}.bb-tag{display:inline-block;background:var(--bb-accent);color:var(--bb-primary);padding:4px 9px;border-radius:99px;font-size:.75rem;font-weight:800}.bb-book h3{margin:10px 0 3px;font-size:1.15rem}.bb-book h3 a{color:inherit;text-decoration:none}.bb-book p{color:var(--bb-muted);margin:5px 0 12px}.bb-form-card{max-width:760px;margin:auto;padding:28px}.bb-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.bb-field{display:flex;flex-direction:column;gap:6px}.bb-field.full{grid-column:1/-1}.bb-field label{font-weight:750;font-size:.92rem}.bb-field input,.bb-field select,.bb-field textarea,.bb-search input,.bb-search select{width:100%;border:1px solid #dcd8e8;border-radius:10px;padding:12px;font:inherit;background:#fff;color:var(--bb-ink)}.bb-field textarea{min-height:115px;resize:vertical}.bb-help{font-size:.82rem;color:var(--bb-muted)}.bb-alert{padding:14px 16px;border-radius:12px;margin-bottom:18px}.bb-alert.success{background:#e7f8ed;color:#176538;border:1px solid #bce8c9}.bb-alert.error{background:#fff0f0;color:#9b2424;border:1px solid #f5c8c8}.bb-alert ul{margin:6px 0 0;padding-left:20px}.bb-search{display:grid;grid-template-columns:1fr 190px auto;gap:10px;margin:20px 0}.bb-review{padding:15px 0;border-top:1px solid var(--bb-border)}.bb-stars{color:#e5a323;letter-spacing:2px}.bb-footer{text-align:center;color:var(--bb-muted);padding:24px;border-top:1px solid var(--bb-border);background:white;font-size:.9rem}
    @media(max-width:760px){.bb-hero{grid-template-columns:1fr;padding:28px}.bb-hero-art{display:none}.bb-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bb-search{grid-template-columns:1fr}.bb-stats{grid-template-columns:1fr}.bb-links{gap:10px}.bb-nav-inner{align-items:flex-start;flex-direction:column}}@media(max-width:500px){.bb-grid,.bb-form-grid{grid-template-columns:1fr}.bb-field.full{grid-column:auto}.bb-container{padding:24px 14px 42px}}
  </style>
</head>
<body>
<header class="bb-nav"><div class="bb-nav-inner"><a class="bb-brand" href="/">📚 BookBuddy</a><nav class="bb-links"><a class="<%= title === 'Home' ? 'active' : '' %>" href="/">Home</a><a class="<%= title === 'Explore Books' ? 'active' : '' %>" href="/books">Explore Books</a><a class="<%= title === 'Add a Book' ? 'active' : '' %>" href="/books/new">Add a Book</a><a class="<%= title === 'Write a Review' ? 'active' : '' %>" href="/reviews/new">Write a Review</a></nav></div></header>
